<CopilotChat
  attachments={{
    enabled: true,
    onUpload: async (file) => {
      const formData = new FormData();
      formData.append("file", file);
      const res = await fetch("/api/upload", { method: "POST", body: formData });
      const { url } = await res.json();
      return {
        type: "url",
        value: url,
        mimeType: file.type,
      };
    },
  }}
/>
